{
  "name": "agent-workbench",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @agent-workbench/web build && pnpm --filter @agent-workbench/api build",
    "start": "pnpm --filter @agent-workbench/api start",
    "bench": "pnpm -r bench",
    "fixtures:large": "node scripts/generate-large-fixture.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}

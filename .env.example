# 不配置 Key 时自动使用 fixture mock 运行时。
# 显式指定运行时：agent | mock
# RUNTIME_MODE=agent

# Anthropic（默认模型 claude-sonnet-4-6）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=

# OpenAI 兼容接口（DeepSeek / Qwen / OpenAI 等）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 可选：覆盖知识库、发版场景与会话存储目录
# KB_DIR=data/docs
# RELEASES_DIR=data/releases
# STORE_DIR=.data
